{
  "schema_version": 1,
  "project": {
    "name": "example-cli",
    "type": "cli",
    "description": "One-line description of what this project does."
  },
  "id": {
    "prefix": "EXC"
  },
  "docs": {
    "index": "AGENTIC-MODE.md",
    "readme": "README.md",
    "agents": "AGENTS.md",
    "requirements": "docs/REQUIREMENTS.md",
    "user_guide": "docs/USER_GUIDE.md",
    "validation": "docs/VALIDATION.md",
    "workflow": "docs/WORKFLOW.md",
    "architecture": null
  },
  "bilingual": {
    "enabled": false,
    "secondary_language": "zh-TW",
    "primary_heading": "## English",
    "secondary_heading": "## 繁體中文"
  },
  "checks": {
    "line_limits": {
      "agents": 200
    },
    "deny_words": [],
    "harness_neutrality": {
      "enabled": true,
      "extra_deny": []
    },
    "url_allowlist": [],
    "forbid_ipv4": false,
    "ipv4_allowlist": ["127.0.0.1", "0.0.0.0"],
    "forbid_local_paths": false,
    "iteration_history": {
      "enabled": false,
      "heading": "Iteration History"
    },
    "commands": [
      {
        "run": "python -m pytest",
        "must_appear_in": ["agents", "readme"]
      }
    ],
    "entrypoints": []
  },
  "ci": {
    "platform": "github"
  }
}
